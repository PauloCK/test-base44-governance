{
  "name": "Auditoria TesteRLS",
  "description": "Teste: registra toda edi\u00e7\u00e3o e dele\u00e7\u00e3o na TesteRLS.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update",
        "delete"
      ],
      "entity_name": "TesteRLS"
    }
  },
  "definition": {
    "do": [
      {
        "registrar": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "function_name": "auditarMudanca",
            "payload": "${ . }"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "auditoria-testerls",
      "namespace": "base44",
      "version": "1.0.0"
    }
  }
}