{
  "name": "TesteRLS",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo curto do registro de teste."
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o livre sobre o teste."
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}